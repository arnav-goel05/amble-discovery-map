{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "performance-snapshot.schema.json",
  "title": "Performance Snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capturedAt",
    "visibility",
    "reducedMotion",
    "capabilities",
    "samples",
    "resources",
    "budgets"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "capturedAt": { "type": "string", "format": "date-time" },
    "visibility": { "enum": ["foreground", "background"] },
    "reducedMotion": { "type": "boolean" },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "value",
          "unit",
          "capturedAt",
          "freshnessMs",
          "state"
        ],
        "properties": {
          "metric": { "type": "string" },
          "value": { "type": ["number", "null"] },
          "unit": {
            "enum": ["ms", "bytes", "count", "fps", "percent", "state"]
          },
          "capturedAt": { "type": "string", "format": "date-time" },
          "freshnessMs": { "type": "number", "minimum": 0 },
          "state": {
            "enum": [
              "healthy",
              "warning",
              "over_budget",
              "pending",
              "unsupported"
            ]
          }
        }
      }
    },
    "resources": { "type": "object" },
    "budgets": { "type": "array" }
  }
}
