{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amble.local/contracts/catalog-get-result.schema.json",
  "title": "Amble Catalog Get Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogRevision", "sources", "items", "missingTargetIds"],
  "properties": {
    "catalogRevision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connectorId", "revision"],
        "properties": {
          "connectorId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "revision": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["targetId", "type", "label", "summary", "attributes"],
        "properties": {
          "targetId": { "type": "string", "minLength": 1, "maxLength": 256 },
          "type": {
            "enum": [
              "area",
              "event",
              "restaurant",
              "plan_stop",
              "saved_item",
              "game"
            ]
          },
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "summary": { "type": ["string", "null"], "maxLength": 1000 },
          "attributes": {
            "type": "object",
            "additionalProperties": false,
            "maxProperties": 12,
            "properties": {
              "areaId": { "type": "string", "maxLength": 256 },
              "planningArea": { "type": "string", "maxLength": 160 },
              "venue": { "type": "string", "maxLength": 200 },
              "startDate": { "type": "string", "maxLength": 40 },
              "endDate": { "type": ["string", "null"], "maxLength": 40 },
              "category": { "type": ["string", "null"], "maxLength": 100 },
              "price": { "type": ["string", "null"], "maxLength": 100 },
              "cuisine": { "type": ["string", "null"], "maxLength": 100 },
              "status": { "type": ["string", "null"], "maxLength": 100 },
              "availability": { "type": ["string", "null"], "maxLength": 100 },
              "distanceMeters": { "type": ["number", "null"], "minimum": 0 },
              "dealCount": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "missingTargetIds": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 256 }
    }
  }
}
