{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amble.local/contracts/event-facet-proposal.schema.json",
  "title": "Voice Event Facet Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["what", "when", "where", "price", "residualQuery", "unresolved"],
  "properties": {
    "what": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/selection" }
    },
    "when": {
      "anyOf": [{ "$ref": "#/$defs/selection" }, { "type": "null" }]
    },
    "where": {
      "anyOf": [{ "$ref": "#/$defs/selection" }, { "type": "null" }]
    },
    "price": {
      "anyOf": [{ "$ref": "#/$defs/selection" }, { "type": "null" }]
    },
    "residualQuery": { "type": "string", "maxLength": 200 },
    "unresolved": {
      "type": "array",
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "enum": ["what", "when", "where", "price"] }
    }
  },
  "$defs": {
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "evidence"],
      "properties": {
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 160 }
      }
    }
  }
}
