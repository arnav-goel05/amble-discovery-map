{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "background-geometry-audit.schema.json",
  "title": "Background Geometry Audit",
  "type": "object",
  "required": [
    "schemaVersion",
    "releaseId",
    "snapshotId",
    "origin",
    "mode",
    "summary",
    "objects",
    "complete"
  ],
  "properties": {
    "schemaVersion": { "const": "background-geometry-audit-v1" },
    "releaseId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "snapshotId": { "type": "string", "minLength": 1 },
    "origin": { "type": "string", "format": "uri" },
    "mode": { "enum": ["audit", "sync"] },
    "complete": { "type": "boolean" },
    "summary": {
      "type": "object",
      "required": [
        "checkedObjects",
        "matchedObjects",
        "staleObjects",
        "failedObjects",
        "retainedIdentityCount",
        "affectedVenueCount"
      ],
      "properties": {
        "checkedObjects": { "type": "integer", "minimum": 0 },
        "matchedObjects": { "type": "integer", "minimum": 0 },
        "staleObjects": { "type": "integer", "minimum": 0 },
        "failedObjects": { "type": "integer", "minimum": 0 },
        "retainedIdentityCount": { "type": "integer", "minimum": 0 },
        "affectedVenueCount": { "type": "integer", "minimum": 0 },
        "uploadedObjects": { "type": "integer", "minimum": 0 },
        "skippedObjects": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "objectKey",
          "status",
          "remoteState",
          "retainedGmlIds",
          "affectedVenueIds"
        ],
        "properties": {
          "objectKey": {
            "type": "string",
            "pattern": "^optimized-tiles/.+\\.b3dm$"
          },
          "status": { "enum": ["matched", "stale", "failed"] },
          "remoteState": {
            "enum": [
              "current",
              "pristine",
              "intermediate",
              "unknown",
              "unavailable"
            ]
          },
          "remoteSha256": { "type": ["string", "null"] },
          "remoteByteLength": { "type": ["integer", "null"], "minimum": 0 },
          "retainedGmlIds": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "affectedVenueIds": {
            "type": "array",
            "items": { "type": "string" },
            "uniqueItems": true
          },
          "error": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
