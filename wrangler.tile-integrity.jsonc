{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "amble-tile-integrity",
  "main": "cloudflare/tile-integrity-worker.mjs",
  "compatibility_date": "2026-07-16",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "r2_buckets": [
    {
      "binding": "TILES_BUCKET",
      "bucket_name": "amble-3d-tiles",
      "remote": true,
    },
  ],
}
