{
  "schemaVersion": "1.1",
  "policyVersion": "openai-realtime-voice-1.1",
  "owner": "Arnav",
  "ownerRole": "project owner",
  "capMicroUsd": 10000000,
  "resetPolicy": "none",
  "enabled": false,
  "modelId": "gpt-realtime-2.1-mini",
  "rateCardVersion": "openai-2026-07-27-gpt-realtime-2.1-mini",
  "maxResponseStagesPerTurn": 3,
  "responseTimeoutSeconds": 30,
  "maxContextTokens": 4000,
  "reasoningEffort": "low",
  "automaticResponseCreation": false,
  "imageInputEnabled": false,
  "killSwitches": {
    "requireBothEnabled": true,
    "environment": {
      "variable": "REALTIME_ENABLED",
      "enabledValue": "true",
      "defaultEnabled": false
    },
    "runtime": {
      "store": "d1",
      "key": "openai-realtime",
      "defaultEnabled": false
    },
    "failureMode": "disabled"
  },
  "rateCard": {
    "version": "openai-2026-07-27-gpt-realtime-2.1-mini",
    "currency": "USD",
    "moneyUnit": "micro-USD",
    "observedAt": "2026-07-27",
    "sources": [
      "https://developers.openai.com/api/docs/models/gpt-realtime-2.1-mini",
      "https://developers.openai.com/api/docs/changelog"
    ],
    "rates": {
      "textInputMicroUsdPerMillionTokens": 600000,
      "cachedTextInputMicroUsdPerMillionTokens": 60000,
      "textOutputMicroUsdPerMillionTokens": 2400000,
      "audioInputMicroUsdPerMillionTokens": 10000000,
      "cachedAudioInputMicroUsdPerMillionTokens": 300000,
      "audioOutputMicroUsdPerMillionTokens": 20000000
    },
    "reservationRules": {
      "ignoreCachedInputDiscounts": true,
      "useHighestEnabledInputRate": true,
      "useHighestEnabledOutputRate": true,
      "roundFractionalMicroUsdUp": true,
      "unknownModelOrRate": "hold-and-disable"
    }
  },
  "worstCaseReservation": {
    "response": {
      "maxInputTokens": 4000,
      "inputRateMicroUsdPerMillionTokens": 10000000,
      "inputReservedMicroUsd": 40000,
      "providerMaxOutputTokens": 4096,
      "outputRateMicroUsdPerMillionTokens": 20000000,
      "outputReservedMicroUsd": 81920,
      "reservedMicroUsd": 121920
    },
    "maxTurnReservedMicroUsd": 121920,
    "admissionInvariant": "spentMicroUsd + reservedMicroUsd + requestedMicroUsd <= capMicroUsd",
    "missingOrUntrustedUsage": "hold-full-reservation-and-disable-new-work"
  }
}
