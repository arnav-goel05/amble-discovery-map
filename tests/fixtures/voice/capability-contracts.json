{
  "schemaVersion": "2.0",
  "protocolVersion": "1.1",
  "fixtureSetId": "voice-capability-parity-v2",
  "registeredConnectorIds": [
    "approved-catalog",
    "application-state",
    "discovery-areas",
    "events",
    "location",
    "map",
    "overlay-navigation",
    "plan",
    "restaurants",
    "tour",
    "transit"
  ],
  "conditionalConnector": {
    "connectorId": "conditional-content",
    "registered": false,
    "reason": "No real saved or game data and matching direct controls exist."
  },
  "excludedExternalConnectorIds": [
    "box",
    "gmail",
    "google-calendar",
    "notion",
    "outlook-calendar",
    "outlook-email",
    "sharepoint",
    "slack",
    "teams"
  ],
  "capabilities": [
    {
      "capabilityId": "app.inspect",
      "version": "2.0",
      "kind": "query",
      "description": "Inspect bounded authoritative application state.",
      "connectorId": "application-state",
      "argumentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "eligibleStates": ["application_initialized"],
      "confirmationClass": "none",
      "contextProvider": "application-state",
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "revision",
          "stateDigest",
          "visibleTargets",
          "focusedTargetId",
          "selectedTargetIds",
          "availableCapabilityIds"
        ],
        "properties": {
          "revision": { "type": "integer", "minimum": 0 },
          "stateDigest": { "type": "string", "minLength": 1, "maxLength": 128 },
          "visibleTargets": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["targetId", "type", "label", "ordinal"],
              "properties": {
                "targetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "type": { "type": "string", "minLength": 1, "maxLength": 64 },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                "ordinal": { "type": "integer", "minimum": 1, "maximum": 50 }
              }
            }
          },
          "focusedTargetId": { "type": ["string", "null"], "maxLength": 256 },
          "selectedTargetIds": {
            "type": "array",
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string", "maxLength": 256 }
          },
          "availableCapabilityIds": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "maxLength": 128,
              "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$"
            }
          }
        }
      }
    },
    {
      "capabilityId": "catalog.search",
      "version": "2.0",
      "kind": "query",
      "description": "Search a bounded page of approved catalogue records.",
      "connectorId": "approved-catalog",
      "argumentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["query", "types", "limit"],
        "properties": {
          "query": { "type": "string", "maxLength": 500 },
          "types": {
            "type": "array",
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "enum": [
                "area",
                "event",
                "restaurant",
                "plan_stop",
                "saved_item",
                "game"
              ]
            }
          },
          "limit": { "type": "integer", "minimum": 1, "maximum": 20 },
          "cursor": { "type": ["string", "null"], "maxLength": 512 }
        }
      },
      "eligibleStates": ["approved_catalog_available"],
      "confirmationClass": "none",
      "contextProvider": "approved-catalog",
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalogRevision",
          "sources",
          "total",
          "truncated",
          "items",
          "nextCursor"
        ],
        "properties": {
          "catalogRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["connectorId", "revision"],
              "properties": {
                "connectorId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          },
          "total": { "type": "integer", "minimum": 0 },
          "truncated": { "type": "boolean" },
          "items": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["targetId", "type", "label"],
              "properties": {
                "targetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "type": {
                  "enum": [
                    "area",
                    "event",
                    "restaurant",
                    "plan_stop",
                    "saved_item",
                    "game"
                  ]
                },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          },
          "nextCursor": { "type": ["string", "null"], "maxLength": 512 }
        }
      }
    },
    {
      "capabilityId": "catalog.get",
      "version": "2.0",
      "kind": "query",
      "description": "Get allowlisted details for bounded stable target IDs.",
      "connectorId": "approved-catalog",
      "argumentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["targetIds"],
        "properties": {
          "targetIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      },
      "eligibleStates": ["approved_catalog_available"],
      "confirmationClass": "none",
      "contextProvider": "approved-catalog",
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["catalogRevision", "sources", "items", "missingTargetIds"],
        "properties": {
          "catalogRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["connectorId", "revision"],
              "properties": {
                "connectorId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          },
          "items": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["targetId", "type", "label"],
              "properties": {
                "targetId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "type": {
                  "enum": [
                    "area",
                    "event",
                    "restaurant",
                    "plan_stop",
                    "saved_item",
                    "game"
                  ]
                },
                "label": { "type": "string", "minLength": 1, "maxLength": 200 }
              }
            }
          },
          "missingTargetIds": {
            "type": "array",
            "maxItems": 10,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 256 }
          }
        }
      }
    },
    {
      "capabilityId": "map.setlayervisibility",
      "version": "2.0",
      "kind": "command",
      "description": "Set one registered map layer to the requested visibility.",
      "connectorId": "map",
      "argumentSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["layerId", "visible"],
        "properties": {
          "layerId": { "enum": ["location", "transit"] },
          "visible": { "type": "boolean" }
        }
      },
      "eligibleStates": ["map_ready"],
      "confirmationClass": "reversible",
      "contextProvider": "map",
      "resultSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "additionalProperties": false,
        "required": ["layerId", "visible"],
        "properties": {
          "layerId": { "enum": ["location", "transit"] },
          "visible": { "type": "boolean" }
        }
      }
    }
  ]
}
