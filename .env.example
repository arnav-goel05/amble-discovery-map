# Public server
HOST=127.0.0.1
PORT=4173
PUBLIC_BASE_URL=https://example.invalid
PLAN_STORE_ROOT=/var/lib/amble/plans
# Optional local-development fallback for R2-hosted 3D geometry.
TILE_FALLBACK_ORIGIN=https://amble.project-hub-arnav.workers.dev

# Sole private administrator (server-side only)
ADMIN_PASSWORD_HASH=

# Optional Telegram challenge (server-side only)
TELEGRAM_GAMES_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
ADAPTIVE_LOCATION_VERIFICATION_ENABLED=true
PHOTO_VERIFICATION_ENABLED=true

# Optional providers are usable only when data/provider-policy.json classifies them free/open.

# Feature 004 voice presentation (public build-time value).
# Local development may opt in; production remains hidden unless explicitly enabled.
VITE_VOICE_UI_ENABLED=true

# Feature 004 realtime voice provider (server-side only; disabled by default)
REALTIME_ENABLED=false
OPENAI_API_KEY=

# Optional automatic event-pipeline dashboard synchronization.
EVENT_DASHBOARD_SYNC_URL=
EVENT_DASHBOARD_SYNC_TOKEN=
